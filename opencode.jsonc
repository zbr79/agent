{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.8-flash",
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "permission": {
    "*": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "npm run build": "allow",
      "npm run build *": "allow",
      "bash scripts/restart-agent-deferred.sh": "allow",
      "./scripts/restart-agent-deferred.sh": "allow",
      "scripts/restart-agent-deferred.sh": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git add": "allow",
      "git add *": "allow",
      "git add -f": "deny",
      "git add -f *": "deny",
      "git add --force": "deny",
      "git add --force *": "deny",
      "git add ..*": "deny",
      "git add *..*": "deny",
      "git add /*": "deny",
      "git add ~*": "deny",
      "git commit": "allow",
      "git commit *": "allow",
      "git commit --amend": "deny",
      "git commit --amend *": "deny",
      "git commit *--amend*": "deny",
      "git push": "allow",
      "git push origin": "allow",
      "git push origin HEAD": "allow",
      "git push origin main": "allow",
      "git push origin HEAD:main": "allow",
      "git push --force": "deny",
      "git push --force *": "deny",
      "git push --force-with-lease": "deny",
      "git push --force-with-lease *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push origin --force": "deny",
      "git push origin --force *": "deny",
      "git push origin -f": "deny",
      "git push origin -f *": "deny",
      "git push origin *--force*": "deny",
      "git push origin *-f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
    },
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      ".server-env": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.server-env": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/id_ecdsa": "deny",
      "**/id_dsa": "deny",
      "**/*_rsa": "deny",
      "**/*_ed25519": "deny",
      "**/*.pem": "deny",
      "**/*.ppk": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      ".server-env": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.server-env": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/id_ecdsa": "deny",
      "**/id_dsa": "deny",
      "**/*_rsa": "deny",
      "**/*_ed25519": "deny",
      "**/*.pem": "deny",
      "**/*.ppk": "deny"
    }
  }
}
