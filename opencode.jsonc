{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.8-flash",
  "permission": {
    "*": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny",
    "bash": "deny",
    "edit": "deny",
    "read": {
      "*": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  }
}
