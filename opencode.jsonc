{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/qwen3.8-flash",
  "permission": {
    "*": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "npm run build": "allow",
      "npm run build *": "allow",
    },
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      ".server-env": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.server-env": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/id_ecdsa": "deny",
      "**/id_dsa": "deny",
      "**/*_rsa": "deny",
      "**/*_ed25519": "deny",
      "**/*.pem": "deny",
      "**/*.ppk": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      ".server-env": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.server-env": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/id_ecdsa": "deny",
      "**/id_dsa": "deny",
      "**/*_rsa": "deny",
      "**/*_ed25519": "deny",
      "**/*.pem": "deny",
      "**/*.ppk": "deny"
    }
  }
}
